---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import RecipeTable from '../components/RecipeTable.astro';
import CookModes from '../components/CookModes.astro';
import Timeline from '../components/Timeline.astro';
import AddToPlan from '../components/AddToPlan.astro';
import recipes from '../generated/recipes.json';
import { counterByName } from '../lib/counters.ts';
import { buildTree, type RawRecipe } from '../lib/tree.ts';
import { layout } from '../lib/layout.ts';
import { url } from '../lib/url.ts';

const all = recipes as unknown as RawRecipe[];
const titles = new Map(all.map((r) => [r.slug, r.title]));

export function getStaticPaths() {
  return (recipes as unknown as RawRecipe[]).map((recipe) => {
    // Built once here and handed to all three views, so the table, the panes and the clock
    // are demonstrably reading the same tree.
    const tree = buildTree(recipe);
    return {
      params: { slug: recipe.slug },
      props: {
        recipe,
        tree,
        grid: layout(tree),
        source: fs.readFileSync(path.resolve(recipe.path), 'utf8'),
      },
    };
  });
}

const { recipe, tree, grid, source } = Astro.props;

// The counter you would most likely have bought it from leads the trail back.
const home = counterByName.get(recipe.counters[0]);

const facts = [
  recipe.metadata.servings && { label: 'serves', value: recipe.metadata.servings },
  // The label is the whole attribution: the value is the author's own `>> time:`, quoted, and
  // this says so. It read "about", which was the site hedging a number it had not worked out —
  // and put that word on the page twice, meaning something else again in the clock's "Needs you".
  recipe.metadata.time && { label: 'recipe says', value: recipe.metadata.time },
  { label: '', value: recipe.category },
].filter(Boolean) as { label: string; value: string }[];
---

<Base title={`${recipe.title} — One Table`} blurb={`${recipe.title} as a single table.`}>
  <nav class="crumbs">
    <a href={url()}>All counters</a>
    {home && <span aria-hidden="true">→</span>}
    {home && <a href={url(`menu/${home.slug}/`)}>{home.name}</a>}
  </nav>

  <header class="masthead">
    <h1>{recipe.title}</h1>
    {recipe.aka.length > 0 && <p class="aka">also called {recipe.aka.join(' · ')}</p>}
  </header>

  <ul class="chips">
    {
      recipe.counters.map((name) => {
        const counter = counterByName.get(name);
        return (
          <li class="clay-chip">
            {counter ? <a href={url(`menu/${counter.slug}/`)}>{name}</a> : name}
          </li>
        );
      })
    }
    {
      facts.map((fact) => (
        <li class="clay-chip">
          {fact.label && `${fact.label} `}
          <b>{fact.value}</b>
        </li>
      ))
    }
  </ul>

  {
    recipe.variants.length > 0 && (
      <p class="variants">
        Also written for{' '}
        {recipe.variants.map((variant, i) => (
          <>
            {i > 0 && ', '}
            <a href={url(`${variant.slug}/`)}>{variant.kit ?? 'the plain way'}</a>
          </>
        ))}
        .
      </p>
    )
  }

  <AddToPlan slug={recipe.slug} />

  <CookModes recipe={recipe} tree={tree}>
    <RecipeTable grid={grid} />
  </CookModes>

  {/*
    Under the panes rather than inside the table pane: the clock is a fact about the recipe,
    not one of the three ways of reading it, so it stays on screen whichever pane is showing.
  */}
  <Timeline recipe={recipe} tree={tree} />

  {
    recipe.cookware.length > 0 && (
      <p class="kit-list">
        <span class="label">You'll need</span> {recipe.cookware.join(' · ')}
      </p>
    )
  }

  {
    recipe.pairsWith.length > 0 && (
      <section class="pairs">
        <h2>Goes with</h2>
        <ul class="shelf">
          {recipe.pairsWith.map((slug) => (
            <li class="clay-surface">
              <a href={url(`${slug}/`)}>
                <h3>{titles.get(slug) ?? slug}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <details class="source">
    <summary>See how it is written</summary>
    <pre><code>{source}</code></pre>
  </details>
</Base>
