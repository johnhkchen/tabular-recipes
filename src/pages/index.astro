---
/*
 * The front door: a row of counters, not a list of recipes. Search sits on top of it and
 * replaces the row with flat results, so there is no separate results page to design.
 *
 * The three dials sit in the same well as the box, because a query and a set of dials narrow
 * one list rather than two. Turning a dial replaces the counter row exactly as typing does —
 * "what can I cook tonight" is a real question with no search term in it, and a page that
 * answers it with a row of shelf names has heard the question and declined to answer.
 *
 * Above them, how many people and over how many days. That row does not add a fourth filter: it
 * says what SIZE the three dials are reading at, so *time you're standing there* is the time at
 * eighteen servings rather than at the four the recipe was written for. The one thing it asks on
 * its own is whether the dish is still good on Thursday, because "over three days" is two
 * questions and scaling only answers one of them.
 *
 * Untouched by any of that: with no query, no dial and nobody to feed, this page is what it was.
 */
import Base from '../layouts/Base.astro';
import recipes from '../generated/recipes.json';
import { DIALS } from '../components/dials.ts';
import { CONTROLS } from '../components/situation.ts';
import { menus } from '../lib/counters.ts';
import type { RawRecipe } from '../lib/tree.ts';
import { url } from '../lib/url.ts';

const all = recipes as unknown as RawRecipe[];
const open = menus(all);

// A few names off each menu, so a panel shows what is actually behind it.
const teaser = (slugs: RawRecipe[]) =>
  slugs
    .slice()
    .sort((a, b) => a.title.length - b.title.length)
    .slice(0, 4)
    .map((r) => r.title);
---

<Base
  title="One Table — everything you would otherwise buy"
  blurb="Recipes drawn as single tables, arranged by where you would buy the thing if you were not making it."
>
  <header class="masthead">
    <h1>Everything you'd otherwise buy</h1>
    <p>
      {all.length} recipes, each drawn as one table: ingredients down the left, what you do with
      them across. Arranged by the counter you'd have got it from instead.
    </p>
  </header>

  <div class="finder clay-well">
    <label class="search">
      <span class="visually-hidden">Search recipes</span>
      <input
        type="search"
        id="finder-q"
        placeholder="Search a dish, or something you ate, or an ingredient you have"
        autocomplete="off"
        spellcheck="false"
        data-index={url('search.json')}
      />
    </label>

    <div class="situation">
      {
        CONTROLS.map((control) => (
          <div class="dial-set">
            <span class="dial-name" id={`situation-${control.id}`}>
              {control.name}
            </span>
            <div class="dial" role="group" aria-labelledby={`situation-${control.id}`}>
              <button
                type="button"
                data-situation={control.id}
                data-value=""
                aria-label={control.anySpoken}
                aria-pressed="true"
              >
                Any
              </button>
              {control.stops.map((stop) => (
                <button
                  type="button"
                  data-situation={control.id}
                  data-value={String(stop.value)}
                  aria-label={stop.spoken}
                  aria-pressed="false"
                >
                  {stop.label}
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="dials">
      {
        DIALS.map((dial) => (
          <div class="dial-set">
            <span class="dial-name" id={`dial-${dial.id}`}>
              {dial.name}
            </span>
            <div class="dial" role="group" aria-labelledby={`dial-${dial.id}`}>
              <button
                type="button"
                data-dial={dial.id}
                data-value=""
                aria-label={dial.anySpoken}
                aria-pressed="true"
              >
                Any
              </button>
              {dial.stops.map((stop) => (
                <button
                  type="button"
                  data-dial={dial.id}
                  data-value={String(stop.value)}
                  aria-label={stop.spoken}
                  aria-pressed="false"
                >
                  {stop.label}
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p class="tally" aria-live="polite">Press <kbd>/</kbd> to search {all.length} recipes</p>
  </div>

  <ul class="results shelf" data-hits hidden></ul>

  {/*
    A recipe that is perfect for two and terrible for six is drawn, with the half it failed said
    out loud. Only what the SITUATION dropped: a recipe that was already failing at the size it
    is written for did not fail because of anything asked here, and putting it under this heading
    would turn a finding into six hundred cards.
  */}
  <section class="wont-scale shelf-group" data-dropped hidden>
    <h2>Not at that size <span class="n" data-dropped-count></span></h2>
    <p class="blurb">These work as written. They don't stretch to what you asked for.</p>
    <ul class="results shelf" data-dropped-list></ul>
  </section>

  {/* Shown, and shown as unanswered — never silently included and never silently dropped. */}
  <section class="cannot-say shelf-group" data-cannot hidden>
    <h2>We can't say for these <span class="n" data-cannot-count></span></h2>
    <p class="blurb">
      Nobody wrote these down in enough detail to tell. They might still be what you want.
    </p>
    <ul class="results shelf" data-unsaid></ul>
  </section>

  <p class="nothing" hidden></p>

  <ul class="counters" data-counters>
    {
      open.map((menu) => (
        <li class="counter clay-surface">
          <a href={url(`menu/${menu.counter.slug}/`)}>
            <h2>{menu.counter.name}</h2>
            <p class="blurb">{menu.counter.blurb}</p>
            <p class="teaser">{teaser(menu.sections.flatMap((s) => s.items)).join(' · ')}</p>
            <p class="count">
              {menu.count} {menu.count === 1 ? 'recipe' : 'recipes'}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<script>
  /*
   * The index is fetched once, on the first keystroke or the first dial press. Until somebody
   * asks the page a question, this page carries no search data at all.
   */
  import {
    OFF,
    SHOW_PASSES,
    SHOW_UNSAID,
    anySet,
    carriesState,
    figures,
    readQuery,
    readSettings,
    tallyLine,
  } from '../components/dials.ts';
  import type { Settings } from '../components/dials.ts';
  import {
    NOBODY,
    SHOW_DROPPED,
    anyoneSet,
    carriesSituation,
    dropped,
    link,
    readSituation,
    reason,
    scaledFor,
    shelve,
    silence,
  } from '../components/situation.ts';
  import type { Situation, SituationItem } from '../components/situation.ts';

  const input = document.querySelector<HTMLInputElement>('#finder-q');
  const hits = document.querySelector<HTMLUListElement>('[data-hits]');
  const cannot = document.querySelector<HTMLElement>('[data-cannot]');
  const cannotCount = document.querySelector<HTMLElement>('[data-cannot-count]');
  const unsaidList = document.querySelector<HTMLUListElement>('[data-unsaid]');
  const notAtSize = document.querySelector<HTMLElement>('[data-dropped]');
  const notAtSizeCount = document.querySelector<HTMLElement>('[data-dropped-count]');
  const notAtSizeList = document.querySelector<HTMLUListElement>('[data-dropped-list]');
  const nothing = document.querySelector<HTMLElement>('.nothing');
  const shelf = document.querySelector<HTMLElement>('[data-counters]');
  const tally = document.querySelector<HTMLElement>('.tally');
  const knobs = [...document.querySelectorAll<HTMLButtonElement>('[data-dial]')];
  const heads = [...document.querySelectorAll<HTMLButtonElement>('[data-situation]')];

  if (
    input && hits && cannot && cannotCount && unsaidList && nothing && shelf && tally &&
    notAtSize && notAtSizeCount && notAtSizeList
  ) {
    const base = input.dataset.index!;
    const home = base.replace(/search\.json$/, '');
    let index: SituationItem[] | null = null;
    let loading: Promise<SituationItem[]> | null = null;
    let settings: Settings = { ...OFF };
    let situation: Situation = { ...NOBODY };

    const load = () => {
      loading ??= fetch(base)
        .then((r) => r.json() as Promise<SituationItem[]>)
        .then((items) => (index = items));
      return loading;
    };

    /*
     * The tally is the one thing on this page that speaks. A keystroke lets it settle first —
     * typing "pasta" should announce once, not five times — and a dial press says so at once,
     * because one deliberate action deserves one answer. 350ms sits above a fast typist's gap
     * between keys and below the point where a number visibly lags the box it belongs to.
     */
    const QUIET = 350;
    let pending: number | undefined;
    const say = (text: string, now: boolean) => {
      window.clearTimeout(pending);
      if (now) tally.textContent = text;
      else pending = window.setTimeout(() => (tally.textContent = text), QUIET);
    };
    /*
     * Anything that writes the tally without going through say() has to cancel what say() has
     * already scheduled, or a count from the query before last lands on top of it 350ms later.
     */
    const hush = () => window.clearTimeout(pending);

    /*
     * A card is a title and the lines somebody asked for: the reason it is on this list, then the
     * figures the dials were set against. A plain search asks for neither and gets exactly the
     * card it always did — one line, no class, the counters it sits on.
     */
    const card = (item: SituationItem, lines: { text: string; cls?: string }[]) => {
      const li = document.createElement('li');
      li.className = 'clay-surface';
      const a = document.createElement('a');
      a.href = `${home}${item.slug}/`;
      const h3 = document.createElement('h3');
      h3.textContent = item.title;
      a.append(h3);
      for (const line of lines) {
        if (!line.text) continue;
        const p = document.createElement('p');
        if (line.cls) p.className = line.cls;
        p.textContent = line.text;
        a.append(p);
      }
      li.append(a);
      return li;
    };

    const more = (text: string) => {
      const li = document.createElement('li');
      li.className = 'more';
      li.textContent = text;
      return li;
    };

    const paintDials = () => {
      for (const knob of knobs) {
        const id = knob.dataset.dial as keyof Settings;
        const value = knob.dataset.value ? Number(knob.dataset.value) : null;
        knob.setAttribute('aria-pressed', String(settings[id] === value));
      }
    };

    const paintSituation = () => {
      for (const head of heads) {
        const id = head.dataset.situation as keyof Situation;
        const value = head.dataset.value ? Number(head.dataset.value) : null;
        head.setAttribute('aria-pressed', String(situation[id] === value));
      }
    };

    /*
     * The URL is either silent or it is the whole state. A pristine front page plus typing
     * writes nothing, exactly as before; the first dial press takes the URL over and from then
     * on it carries the query too, so a link a reader keeps for next Tuesday reproduces the
     * list they kept it for. replaceState rather than pushState: a dial already has an "Any"
     * stop, and thirteen history entries would bury the page they arrived from.
     */
    const syncUrl = () => {
      const asked = anySet(settings) || anyoneSet(situation);
      const carried = carriesState(location.search) || carriesSituation(location.search);
      if (!asked && !carried) return;
      const next = `${location.pathname}${link(input.value, settings, situation)}`;
      history.replaceState(null, '', next);
    };

    const render = (announceNow: boolean) => {
      const query = input.value;
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      const dialsOn = anySet(settings);
      const sized = anyoneSet(situation);

      if ((!words.length && !dialsOn && !sized) || !index) {
        hits.hidden = true;
        cannot.hidden = true;
        notAtSize.hidden = true;
        nothing.hidden = true;
        shelf.hidden = false;
        hush();
        tally.innerHTML = `Press <kbd>/</kbd> to search`;
        return;
      }

      const matched = words.length
        ? index.filter((item) => words.every((word) => item.find.includes(word)))
        : index;

      const passes: SituationItem[] = [];
      const notAtThisSize: SituationItem[] = [];
      const unsaid: SituationItem[] = [];
      let failed = 0;
      for (const item of matched) {
        const where = shelve(item, settings, situation);
        if (where === 'match') passes.push(item);
        else if (where === 'dropped') notAtThisSize.push(item);
        else if (where === 'unsaid') unsaid.push(item);
        else failed++;
      }

      shelf.hidden = true;
      hits.hidden = passes.length === 0;
      notAtSize.hidden = notAtThisSize.length === 0;
      cannot.hidden = unsaid.length === 0;
      nothing.hidden = passes.length > 0 || unsaid.length > 0 || notAtThisSize.length > 0;
      nothing.textContent = sized
        ? 'Nothing on the shelf stretches that far. Try fewer days, or fewer people.'
        : dialsOn
          ? 'Nothing on the shelf fits that. Try a longer time, or fewer things to wash.'
          : 'Nothing matches that. Try an ingredient, or what the menu called it.';

      /*
       * The figures a card shows are the figures at the size that was asked for — the whole
       * point of the row above the dials — so they are read off the scaled recipe rather than
       * the written one. With nobody to feed, scaledFor() hands back the same object and the
       * card is the one T-010-02 drew.
       */
      hits.replaceChildren(
        ...passes.slice(0, SHOW_PASSES).map((item) =>
          card(
            item,
            dialsOn || sized
              ? [
                  { text: sized ? reason(item, situation) : '', cls: 'reason' },
                  { text: dialsOn ? figures(scaledFor(item, situation), settings) : '', cls: 'figures' },
                ]
              : [{ text: item.counters.join(' · ') }],
          ),
        ),
      );
      if (passes.length > SHOW_PASSES) {
        const rest = passes.length - SHOW_PASSES;
        hits.append(
          more(
            dialsOn || sized
              ? `and ${rest} more — turn a dial down, or search`
              : `and ${rest} more — keep typing`,
          ),
        );
      }

      notAtSizeCount.textContent = String(notAtThisSize.length);
      notAtSizeList.replaceChildren(
        ...notAtThisSize
          .slice(0, SHOW_DROPPED)
          .map((item) => card(item, [{ text: dropped(item, settings, situation), cls: 'reason' }])),
      );
      if (notAtThisSize.length > SHOW_DROPPED) {
        notAtSizeList.append(more(`and ${notAtThisSize.length - SHOW_DROPPED} more that don’t`));
      }

      cannotCount.textContent = String(unsaid.length);
      unsaidList.replaceChildren(
        ...unsaid
          .slice(0, SHOW_UNSAID)
          .map((item) => card(item, [{ text: silence(item, settings, situation), cls: 'unsaid' }])),
      );
      if (unsaid.length > SHOW_UNSAID) {
        unsaidList.append(more(`and ${unsaid.length - SHOW_UNSAID} more we can’t say for`));
      }

      /*
       * One sentence, three counts, as it was. The recipes that dropped out at this size are
       * counted among the ones that don't — they are a failure with a reason, not a fourth
       * answer — and their own heading says how many they are, the way the unanswered shelf does.
       */
      say(
        dialsOn || sized
          ? tallyLine({
              pass: passes.length,
              fail: failed + notAtThisSize.length,
              unsaid: unsaid.length,
            })
          : `${passes.length} of ${index.length} recipes`,
        announceNow,
      );
    };

    const asked = () => anySet(settings) || anyoneSet(situation) || Boolean(input.value.trim());

    input.addEventListener('input', async () => {
      if (asked()) await load();
      render(false);
      syncUrl();
    });

    for (const knob of knobs) {
      knob.addEventListener('click', async () => {
        const id = knob.dataset.dial as keyof Settings;
        const value = knob.dataset.value ? Number(knob.dataset.value) : null;
        settings = { ...settings, [id]: value };
        paintDials();
        syncUrl();
        if (asked()) await load();
        render(true);
      });
    }

    for (const head of heads) {
      head.addEventListener('click', async () => {
        const id = head.dataset.situation as keyof Situation;
        const value = head.dataset.value ? Number(head.dataset.value) : null;
        situation = { ...situation, [id]: value };
        paintSituation();
        syncUrl();
        if (asked()) await load();
        render(true);
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== input) {
        event.preventDefault();
        input.focus();
        input.select();
      }
    });

    // A shared link should land on the same list — the query, the dials and the situation.
    const start = location.search;
    const query = readQuery(start);
    settings = readSettings(start);
    situation = readSituation(start);
    if (query || anySet(settings) || anyoneSet(situation)) {
      input.value = query;
      paintDials();
      paintSituation();
      load().then(() => render(true));
    }
  }
</script>
