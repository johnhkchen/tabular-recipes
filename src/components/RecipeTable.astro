---
import type { Grid } from '../lib/layout.ts';

interface Props {
  grid: Grid;
}

const { grid } = Astro.props;
---

<figure class="table-well clay-well">
  <!--
    table-view exists only to hold the edge cue against the scroller. The scroller cannot hold it
    itself: anything positioned inside a scroll box scrolls with the content, and an inset shadow
    paints underneath the cells.
  -->
  <div class="table-view">
    <div class="table-scroll">
      <table class="recipe-table" data-slug={grid.slug}>
        <caption class="visually-hidden">
          {grid.title}: ingredients down the left, what to do with them across.
          Tap any cell to cross it off.
        </caption>
        <tbody>
          {
            grid.headers.map((text, i) => (
              <tr>
                <td class="cell cell--prep" colspan={grid.colCount} data-cell={`h${i}`}>
                  {text}
                </td>
              </tr>
            ))
          }
          {
            grid.rows.map((row) => (
              <tr>
                {row.map((cell) =>
                  cell.kind === 'blank' ? (
                    <td class="cell cell--blank" rowspan={cell.rowSpan} colspan={cell.colSpan} />
                  ) : (
                    <td
                      class={`cell cell--${cell.kind}`}
                      rowspan={cell.rowSpan}
                      colspan={cell.colSpan}
                      data-cell={cell.id}
                    >
                      {cell.parts ? (
                        <>
                          <span class="qty">{cell.parts.quantity}</span>
                          {cell.parts.note && <span class="note">({cell.parts.note})</span>}
                          <span class="name">{cell.parts.name}</span>
                        </>
                      ) : (
                        cell.text
                      )}
                    </td>
                  ),
                )}
              </tr>
            ))
          }
          {
            grid.footers.map((text, i) => (
              <tr>
                <td class="cell cell--prep" colspan={grid.colCount} data-cell={`f${i}`}>
                  {text}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
  <figcaption class="table-foot">
    <span class="hint">
      Tap anything to cross it off.
      <span class="table-more" hidden>More to the right — drag the table across.</span>
    </span>
    <button class="clay-button clay-button--soft reset" type="button" hidden>Clear the marks</button>
  </figcaption>
</figure>

<script>
  // Tap a cell to cross it off while cooking. Kept per recipe in this browser only.
  document.querySelectorAll<HTMLTableElement>('.recipe-table').forEach((table) => {
    const key = `tabular-recipes:${table.dataset.slug}`;
    const reset = table.closest('.table-well')?.querySelector<HTMLButtonElement>('.reset');

    const load = (): Set<string> => {
      try {
        const raw = localStorage.getItem(key);
        return new Set(raw ? (JSON.parse(raw) as string[]) : []);
      } catch {
        return new Set();
      }
    };

    const done = load();

    const save = () => {
      try {
        localStorage.setItem(key, JSON.stringify([...done]));
      } catch {
        /* private browsing — the marks just will not survive a reload */
      }
      if (reset) reset.hidden = done.size === 0;
    };

    const cells = table.querySelectorAll<HTMLTableCellElement>('[data-cell]');
    cells.forEach((cell) => {
      const id = cell.dataset.cell!;
      if (done.has(id)) cell.dataset.done = '';
      cell.tabIndex = 0;
      cell.setAttribute('role', 'button');
      cell.setAttribute('aria-pressed', String(done.has(id)));

      const toggle = () => {
        const nowDone = cell.dataset.done === undefined;
        if (nowDone) {
          cell.dataset.done = '';
          done.add(id);
        } else {
          delete cell.dataset.done;
          done.delete(id);
        }
        cell.setAttribute('aria-pressed', String(nowDone));
        save();
      };

      cell.addEventListener('click', toggle);
      cell.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggle();
        }
      });
    });

    /*
     * Say when the table continues past the edge — but only when it really does.
     *
     * A recipe wider than the screen looked exactly like a recipe that fits, so a seven-column
     * recipe could read as a four-column one. The stylesheet cannot tell the difference: it
     * knows the window, not how wide this particular table came out. So it is measured here,
     * and what is measured drives both the words below the table and the shadow beside the
     * pinned column.
     *
     * "More" means there is table to the RIGHT you have not seen, so it goes away once you
     * reach the end. Watching the table as well as the scroller matters: a late font can make
     * the table wider inside a box whose own size never changed.
     */
    const scroll = table.closest<HTMLElement>('.table-scroll');
    const well = table.closest<HTMLElement>('.table-well');
    const more = well?.querySelector<HTMLElement>('.table-more');

    if (scroll && well) {
      let said: boolean | null = null;
      const measure = () => {
        const room = scroll.scrollWidth - scroll.clientWidth;
        const unseen = room > 1 && scroll.scrollLeft < room - 1;
        if (unseen === said) return; // nothing to write, so no style recalc while a finger moves
        said = unseen;
        well.toggleAttribute('data-more', unseen);
        if (more) more.hidden = !unseen;
      };

      measure();
      scroll.addEventListener('scroll', measure, { passive: true });
      const watch = new ResizeObserver(measure);
      watch.observe(scroll);
      watch.observe(table);
    }

    reset?.addEventListener('click', () => {
      done.clear();
      cells.forEach((cell) => {
        delete cell.dataset.done;
        cell.setAttribute('aria-pressed', 'false');
      });
      save();
    });

    if (reset) reset.hidden = done.size === 0;
  });
</script>
