---
/*
 * The strip under the table: how the time goes.
 *
 * Three decisions hold this up.
 *
 * 1. THE AXIS IS TO SCALE. Durations here run from 30 seconds to three weeks, and the axis is
 *    cut at every moment something starts or finishes — a "stretch" — but each stretch is as
 *    wide as it is long, linearly. It was logarithmic first, to stop the dill pickles' 3-week
 *    ferment taking 91% of the strip; that stopped it by making a 12-hour rise barely three
 *    times a 1-minute boil, which is not a timeline. If a recipe is mostly one long wait, the
 *    drawing should say so at a glance, because that is usually the most useful thing it can
 *    say. The floor is in pixels, not in share, so the proportions stay exactly true at every
 *    width while the shortest stretch still keeps enough room to be seen. A stretch too narrow
 *    for its own label goes unlabelled on the axis rather than lying about its width — its
 *    duration is printed beside its row either way, so no number lives only in a width.
 *
 * 2. NOTHING IS INVENTED, AND THE DOUBT RIDES ON THE NUMBER. An operation the recipe never
 *    timed has no bar — it gets a mark at the moment it happens and the words "not timed".
 *    Where that leaves a figure short, the figure says "at least" and the count of untimed
 *    steps sits under it as a fact about the recipe; where a figure is our reading rather than
 *    the author's, it says "about". No paragraph explains either: a cook needs to know the
 *    number is approximate, not why. A recipe that times nothing at all says so in one line.
 *
 * 3. THE PICTURE NEVER CARRIES ANYTHING ALONE. Hands-on and unattended differ by fill
 *    (solid vs. hatched), by height, by icon and by the words next to them, so colour is the
 *    fourth signal and never the first. Whether the attention was the author's word or our
 *    reading — the minutes are always the author's own — is drawn as the bar's edge, solid or
 *    dashed, written beside every bar as "(we think)", and named in the legend.
 *
 * Every task row carries `data-cell`, which is the same id its operation cell has in
 * layout.ts, so a page that wants to light up the table when you touch a bar can, without
 * this component owning that behaviour. There is no script here: nothing has to be clicked.
 */
import { formatDuration } from '../lib/time.ts';
import { iconForOperation, iconSvg, type IconName } from '../lib/icons.ts';
import { attentionIsOurs, buildSchedule, type Schedule, type Task } from '../lib/schedule.ts';
import { slackWord } from '../lib/slack.ts';
import { buildTree, type RawRecipe, type RecipeTree } from '../lib/tree.ts';

interface Props {
  recipe: RawRecipe;
  /** Pass the tree the page already built; it is only rebuilt if you do not. */
  tree?: RecipeTree;
  /** Likewise the schedule, for a page that wants it for something else too. */
  schedule?: Schedule;
}

const {
  recipe,
  tree = buildTree(recipe),
  schedule = buildSchedule(recipe, tree),
} = Astro.props;

const round = (minutes: number) => Math.round(minutes * 100) / 100;

/* ---------------------------------------------------------------- the axis */

// Every moment at which something starts or finishes. The gaps between them are the
// stretches, and they are the only columns the chart has.
const marks = [...new Set(schedule.tasks.flatMap((task) => [task.start, task.end]))].sort(
  (a, b) => a - b,
);
const markIndex = new Map(marks.map((minute, i) => [minute, i]));

const stretches = marks.slice(0, -1).map((from, i) => ({
  minutes: round(marks[i + 1] - from),
  text: formatDuration(round(marks[i + 1] - from)),
}));

/**
 * Width of a stretch: its real duration, linearly.
 *
 * This was logarithmic, to stop an eighteen-hour rise swallowing the chart. It stopped it
 * by swallowing the proportions instead — bagels drew a twelve-hour rise barely three times
 * the width of a one-minute boil, and a timeline that is not scaled to time is not a
 * timeline. If a recipe is mostly one long wait, the honest drawing says so at a glance,
 * and that is usually the most useful thing it can say.
 *
 * The floor is in PIXELS rather than in share, so the proportions stay exactly true at
 * every width while the shortest stretch still keeps enough room to be seen. A dozen
 * stretches at this floor come to 132px, so a 320px phone is never forced sideways.
 */
const FLOOR_PX = 11;
const span = stretches.reduce((sum, s) => sum + s.minutes, 0) || 1;
const columns = stretches
  .map((s) => `minmax(${FLOOR_PX}px, ${Math.max(s.minutes, 0.001).toFixed(3)}fr)`)
  .join(' ');

/*
 * At true scale a short stretch is too narrow for its own label, so the axis only labels
 * the ones with room. Nothing is lost: every row prints its own duration beside it.
 *
 * Two questions, asked in two places, because they are two different questions. This one —
 * is this stretch big enough that a number on it is worth reading — is about the recipe, so
 * it is answered here. Whether the label then FITS the column it landed in is about the
 * window, and only the browser knows that; see the @container rules under .stretch.
 */
const LABEL_AT = 0.08;

/*
 * How much room a label needs, indexed by how many characters it has.
 *
 * Measured rather than guessed: every one of the 93 duration strings formatDuration() can
 * produce for this collection, rendered in Karla at the 0.68rem the axis uses. The vocabulary
 * is small enough — "8 hr", "38 min", "21 days", "13 hr 50 min" — that length sorts them with
 * no overlap, and each entry here is the WIDEST label of that length, rounded up to the pixel.
 * So the rule errs towards holding a label back rather than towards stacking one that will not
 * fit, which costs a handful of labels across the whole collection and buys never having to
 * read "1 hr / 10 / min" down three lines.
 *
 * These are text widths, with no padding in them, because that is what the rules below compare
 * against: a size container is queried on its CONTENT box, so the stretch's own 0.1rem sides
 * are already out of the number the browser tests.
 */
const LABEL_FITS_AT = [20, 20, 20, 20, 20, 30, 36, 36, 52, 52, 52, 58, 61];
const fitsAt = (text: string) => LABEL_FITS_AT[Math.min(text.length, LABEL_FITS_AT.length - 1)];

const axis = stretches.map((stretch) => ({
  ...stretch,
  labelled: stretch.minutes / span >= LABEL_AT,
  fitsAt: fitsAt(stretch.text),
}));

/* --------------------------------------------------------------- the rows */

const ATTENTION: Record<string, { word: string; icon: IconName }> = {
  'hands-on': { word: 'needs you', icon: 'hand' },
  unattended: { word: 'walk away', icon: 'hourglass' },
};

/*
 * What we are allowed to claim about the attention, in the author's absence — two words, on the
 * claim itself, rather than a paragraph under the chart explaining how we came by it. It is the
 * same phrase the cook pane uses, and the same thing the dashed edge and the legend say.
 */
const OUR_READING = 'we think';

interface Row {
  task: Task;
  icon: IconName;
  /** True when there is a real duration to draw a bar for. */
  spans: boolean;
  /** Grid line the bar or mark starts at. */
  from: number;
  to: number;
  duration: string;
  when: string;
  attention: { word: string; icon: IconName } | null;
  hedge: string;
}

const rows: Row[] = [...schedule.tasks]
  .sort((a, b) => a.start - b.start || a.column - b.column || a.id.localeCompare(b.id))
  .map((task) => {
    const from = markIndex.get(task.start) ?? 0;
    const to = markIndex.get(task.end) ?? from;
    return {
      task,
      icon: iconForOperation(task.label),
      spans: task.minutes > 0,
      from,
      to,
      duration: formatDuration(task.minutes) || (task.timed ? 'no length given' : 'not timed'),
      when: task.start > 0 ? `${formatDuration(task.start)} in` : 'from the start',
      attention: ATTENTION[task.attention] ?? null,
      hedge: task.minutes > 0 && attentionIsOurs(task) ? OUR_READING : '',
    };
  });

/*
 * How many operations are genuinely running at once — the one thing a numbered list of steps
 * hides, and the reason a dish can hold more work than clock. Counted rather than merely
 * spotted, because on the pages where those two numbers disagree the count is what says why.
 */
const overlapping = rows.filter(
  (row) =>
    row.spans &&
    rows.some(
      (other) =>
        other !== row &&
        other.spans &&
        row.task.start < other.task.end &&
        other.task.start < row.task.end,
    ),
).length;

/* ----------------------------------------------------------- the headline */

const stepCount = schedule.tasks.length;
const untimed = schedule.untimedCount;
const allTimed = untimed === 0;
const timesNothing = schedule.totalMinutes === 0;

/*
 * The author's own `>> time:` is deliberately NOT printed here. It is already on the page, as
 * an "about 3 hr 30 min" chip under the title, where the servings and the category are — which
 * is where a claim of the author's belongs. Repeating it inside a panel of worked-out numbers
 * made it look like a third worked-out number, and on pizzelle, where the author says 45 min
 * and the timers add up to 45 sec, that reads as the panel contradicting itself.
 */

/** Any bar whose hands-on / walk-away reading is ours rather than the recipe's own word. */
const anyOurReading = rows.some((row) => row.spans && attentionIsOurs(row.task));

/*
 * An operation nobody timed ends the moment it starts, so start-to-finish is the sum of what
 * WAS timed and nothing else — a floor, not a total. Pizzelle times the 45 seconds in the iron
 * and none of the four steps around it, and a bare "45 sec" in display type over a recipe
 * whose own header says 45 min is not an understatement, it is the wrong answer. "About" would
 * be no better there: it would claim the truth is near 45 seconds. A floor is the one thing we
 * honestly know, so the number says so, and the count of what is missing sits under it.
 */
const totalText = `${allTimed ? '' : 'at least '}${formatDuration(schedule.totalMinutes)}`;
const totalSub = allTimed
  ? ''
  : `${untimed} of ${stepCount} ${untimed === 1 ? 'steps gives' : 'steps give'} no time`;

/*
 * The hands-on figure is fuzzy rather than short, so it takes the other word.
 *
 * It is wrong in both directions at once: untimed steps leave minutes out of it, and hands-on
 * is the fallback whenever a step says nothing about whether you can leave — french onion
 * soup's 50-minute caramelise is in there on our say-so alone. A floor word would claim a
 * direction we do not have; "about" is the honest shape of the number, and it is the word the
 * page already uses for the author's own time in the chips above.
 */
const handsOnText = formatDuration(schedule.handsOnMinutes) || (allTimed ? 'none of it' : 'none given');
const handsOnFigure =
  schedule.handsOnMinutes > 0 && (!allTimed || anyOurReading)
    ? `about ${handsOnText}`
    : handsOnText;

/*
 * What the "needs you" figure may say under itself.
 *
 * Two branches at once is more work than there is clock, which is arithmetic rather than a
 * mistake — but "needs you 34 min" printed beside "start to finish 24 min" reads as one of them
 * being wrong. The count of operations sharing the clock is the fact that makes it ordinary,
 * and it is a fact about the recipe rather than about our sums.
 *
 * "The rest you can walk away from" is only true when every step is timed. Blondies time the
 * bake and nothing else, so hands-on comes to zero — and "none of it / the rest you can walk
 * away from" tells a cook they may leave the room through four steps nobody put a number on.
 * Where neither holds, the line under the clock already says how many steps gave no time, so
 * there is nothing left to add.
 */
const needsYouSub =
  schedule.handsOnMinutes > schedule.totalMinutes
    ? `${overlapping} steps run at once`
    : allTimed && schedule.unattendedMinutes > 0
      ? 'the rest you can walk away from'
      : '';

const legend = {
  hands: rows.some((row) => row.spans && row.task.attention === 'hands-on'),
  wait: rows.some((row) => row.spans && row.task.attention === 'unattended'),
  mark: rows.some((row) => !row.spans),
  ours: anyOurReading,
};

/*
 * The third fact about the recipe, next to the two the clock counts: what happens if you
 * get it wrong. Authored, never worked out from the timers above it — and null for most of
 * the collection, which draws nothing at all rather than an empty slot. A recipe that cannot
 * name its real failure has not earned a rating, so silence here is an answer, not a gap.
 */
const slack = recipe.slack;

const headingId = `clock-${recipe.slug}`;
---

<section class="timeline clay-surface" aria-labelledby={headingId} style={`--stretches: ${columns}`}>
  <h2 id={headingId}>The clock</h2>

  {
    timesNothing ? (
      <p class="verdict">Not one of its {stepCount} steps is timed.</p>
    ) : (
      <dl class="stats">
        <div class="stat">
          <dt>Start to finish</dt>
          <dd>
            <b>{totalText}</b>
            {totalSub && <span class="sub">{totalSub}</span>}
          </dd>
        </div>
        <div class="stat">
          <dt>Needs you</dt>
          <dd>
            <b>{handsOnFigure}</b>
            {needsYouSub && <span class="sub">{needsYouSub}</span>}
          </dd>
        </div>
      </dl>
    )
  }

  {
    slack && (
      <dl class="slack" data-level={slack.level}>
        <dt>If you get it wrong</dt>
        <dd>
          <b>{slackWord(slack.level)}</b> — {slack.reason}
        </dd>
      </dl>
    )
  }

  {
    stretches.length > 0 && (
      <>
        <p class="axis-caption" aria-hidden="true">Drawn to scale, longest wait and all:</p>
        <div class="axis" aria-hidden="true">
          {axis.map((stretch, i) => (
            <span class="stretch" style={`grid-column: ${i + 1}`} title={stretch.text}>
              {stretch.labelled && (
                <span class="stretch-label" data-fits={stretch.fitsAt}>
                  {stretch.text}
                </span>
              )}
            </span>
          ))}
        </div>
      </>
    )
  }

  <ol class="rows">
    {
      rows.map((row) => (
        <li class="row" data-cell={row.task.id}>
          <p class="what">
            <span class="op-icon" set:html={iconSvg(row.icon, { size: 17 })} />
            <span class="label">{row.task.label}</span>
          </p>

          <p class="facts">
            <span class:list={['dur', !row.spans && 'dur--none']}>{row.duration}</span>
            {row.attention && (
              <span class="tag" data-attention={row.task.attention}>
                <span class="tag-icon" set:html={iconSvg(row.attention.icon, { size: 13 })} />
                {row.attention.word}
                {row.hedge && <i class="hedge">({row.hedge})</i>}
              </span>
            )}
            <span class="when">{row.when}</span>
          </p>

          {stretches.length > 0 && (
            <div class="track" aria-hidden="true">
              {stretches.map((_, i) => (
                <span class="rule" style={`grid-column: ${i + 1}`} />
              ))}
              {row.spans ? (
                <span
                  class="bar"
                  data-attention={row.task.attention}
                  data-reading={attentionIsOurs(row.task) ? 'ours' : undefined}
                  style={`grid-column: ${row.from + 1} / ${row.to + 1}`}
                />
              ) : (
                <span
                  class="mark"
                  style={`grid-column: ${Math.min(row.from + 1, stretches.length)}; justify-self: ${row.from >= stretches.length ? 'end' : 'start'}`}
                />
              )}
            </div>
          )}
        </li>
      ))
    }
  </ol>

  <ul class="legend" aria-label="How to read the bars" hidden={stretches.length === 0}>
    {
      legend.hands && (
        <li>
          <span class="swatch swatch--hands" aria-hidden="true" /> needs you
        </li>
      )
    }
    {
      legend.wait && (
        <li>
          <span class="swatch swatch--wait" aria-hidden="true" /> you can walk away
        </li>
      )
    }
    {
      legend.mark && (
        <li>
          <span class="swatch swatch--mark" aria-hidden="true" /> never timed
        </li>
      )
    }
    {/*
      The dashed edge, named where a key belongs rather than in a paragraph under the chart.
      Two words, and the same two words print beside every bar that wears it, so a reader who
      never looks down here still finds out from the row.
    */}
    {
      legend.ours && (
        <li>
          <span class="swatch swatch--ours" aria-hidden="true" /> we think
        </li>
      )
    }
  </ul>
</section>

<style>
  .timeline {
    padding: clamp(0.9rem, 3.5vw, 1.4rem);
    margin: 1rem 0 1.5rem;
    font-family: var(--clay-font-body);
    color: var(--clay-ink);
  }

  h2 {
    font-family: var(--clay-font-display);
    font-size: clamp(1.05rem, 4vw, 1.3rem);
    margin: 0 0 0.7rem;
  }

  /* --- the two numbers, first thing read ------------------------------- */

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
  }

  .stat {
    flex: 1 1 8.5rem;
    min-width: 0;
    padding: 0.6rem 0.75rem 0.7rem;
    background: var(--clay-well);
    border-radius: var(--clay-radius-sm);
    box-shadow: var(--clay-shadow-well);
  }

  /* Ink-soft is a shade light for small text on the darker well, so it is walked back
     towards the ink until it clears 4.5:1. */
  .stat dt,
  .stat .sub {
    color: color-mix(in srgb, var(--clay-ink-soft) 78%, var(--clay-ink));
  }

  .stat dt {
    font-size: 0.78rem;
    letter-spacing: 0.01em;
  }

  .stat dd {
    margin: 0.1rem 0 0;
  }

  .stat b {
    display: block;
    font-family: var(--clay-font-display);
    font-size: clamp(1.2rem, 5.5vw, 1.55rem);
    line-height: 1.15;
    font-weight: 600;
  }

  .stat .sub {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .verdict {
    margin: 0;
    padding: 0.7rem 0.8rem;
    background: var(--clay-well);
    border-radius: var(--clay-radius-sm);
    box-shadow: var(--clay-shadow-well);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* --- what happens if you get it wrong -------------------------------- */

  /* The same well as the two numbers, so it reads as one family of facts — but full width,
     because the value is the sentence and a sentence needs a line. No colour keyed to the
     level: this panel's rule is that colour is the fourth signal, never the first, and a
     traffic light over someone's dinner would be alarm rather than information. */
  .slack {
    margin: 0.55rem 0 0;
    padding: 0.6rem 0.75rem 0.7rem;
    background: var(--clay-well);
    border-radius: var(--clay-radius-sm);
    box-shadow: var(--clay-shadow-well);
  }

  .slack dt {
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--clay-ink-soft) 78%, var(--clay-ink));
  }

  .slack dd {
    margin: 0.1rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .slack b {
    font-family: var(--clay-font-display);
    font-weight: 600;
  }

  /* --- the broken axis -------------------------------------------------- */

  .axis-caption {
    margin: 1.1rem 0 0.25rem;
    font-size: 0.72rem;
    color: var(--clay-ink-soft);
  }

  .axis {
    display: grid;
    grid-template-columns: var(--stretches);
    align-items: end;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--clay-border);
  }

  /*
   * One size, not a clamp. The clamp only ever bound below a 453px window, where it took the
   * smallest type on the site down to 9.6px on the surface with the least room — and the fit
   * rules below are measured at one size, so two sizes would mean two sets of thresholds for a
   * 13% difference. Above 453px this is the size it already was.
   */
  .stretch {
    grid-row: 1;
    min-width: 0;
    padding: 0 0.1rem;
    font-size: 0.68rem;
    line-height: 1.2;
    text-align: center;
    color: var(--clay-ink-soft);
    overflow-wrap: break-word;
    /* Each stretch measures its own column, so the rules below can ask whether the label fits. */
    container-type: inline-size;
  }

  /*
   * A label shows only when the column it belongs to can hold it on one line.
   *
   * These numbers are not breakpoints and they are deliberately not in the block at the top of
   * site.css: each is the width of a COLUMN, which the browser measures for us, not the width
   * of a window. No viewport query could answer this — the same phone draws one stretch at
   * 278px and the next at 11px, because the width is the recipe's, not the device's.
   *
   * data-fits carries the room this label needs; the table it comes from is LABEL_FITS_AT
   * above, and these six numbers are that table's six values. A browser without container
   * queries fires none of these, every label renders, and a long one wraps inside its own
   * column exactly as it did before — the old behaviour, not a broken one. Same for a font
   * whose metrics beat the measurement: it wraps, it never spills, because .stretch keeps
   * min-width: 0 and overflow-wrap: break-word.
   */
  @container (max-width: 20px) {
    .stretch-label[data-fits='20'] { display: none; }
  }
  @container (max-width: 30px) {
    .stretch-label[data-fits='30'] { display: none; }
  }
  @container (max-width: 36px) {
    .stretch-label[data-fits='36'] { display: none; }
  }
  @container (max-width: 52px) {
    .stretch-label[data-fits='52'] { display: none; }
  }
  @container (max-width: 58px) {
    .stretch-label[data-fits='58'] { display: none; }
  }
  @container (max-width: 61px) {
    .stretch-label[data-fits='61'] { display: none; }
  }

  /* A dashed rule is the seam where the axis was cut. */
  .stretch + .stretch,
  .rule + .rule {
    border-left: 1px dashed var(--clay-border);
  }

  /* --- one row per operation -------------------------------------------- */

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    padding: 0.5rem 0 0.35rem;
    border-bottom: 1px solid var(--clay-border);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .what {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.35;
  }

  .op-icon {
    flex: 0 0 auto;
    margin-top: 0.1rem;
    color: var(--clay-primary);
  }

  .op-icon :global(svg),
  .tag-icon :global(svg),
  .swatch :global(svg) {
    display: block;
  }

  .label {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.45rem;
    margin: 0.3rem 0 0.35rem;
    font-size: 0.75rem;
    color: var(--clay-ink-soft);
  }

  /* The duration, in words, next to the bar it belongs to. A bar can be a sliver; this
     never is. */
  .dur {
    padding: 0.05rem 0.4rem;
    background: var(--clay-well);
    border-radius: var(--clay-radius-pill);
    box-shadow: var(--clay-shadow-well);
    font-weight: 700;
    color: var(--clay-ink);
  }

  .dur--none {
    font-weight: 500;
    font-style: italic;
    color: var(--clay-ink-soft);
    box-shadow: none;
    background: transparent;
    border: 1px dotted var(--clay-ink-soft);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
  }

  .tag[data-attention='hands-on'] {
    color: var(--clay-primary-strong);
  }

  .hedge {
    font-style: italic;
  }

  /* --- the bars ---------------------------------------------------------- */

  .track {
    display: grid;
    grid-template-columns: var(--stretches);
    align-items: center;
    height: 1.1rem;
  }

  .rule {
    grid-row: 1;
    height: 100%;
    min-width: 0;
  }

  .bar {
    grid-row: 1;
    /* No min-width: a bar always covers at least one whole column, and the share floor
       keeps the narrowest column wide enough to see. Nothing here may overflow, because
       the page must not scroll sideways on a phone. */
    min-width: 0;
    border-radius: var(--clay-radius-pill);
    border: 1px solid color-mix(in srgb, var(--clay-ink) 45%, transparent);
  }

  /* Solid and tall: time you have to be there for. */
  .bar[data-attention='hands-on'] {
    height: 0.8rem;
    background: var(--clay-primary);
    box-shadow: var(--clay-shadow-raised);
  }

  /* Hatched and low: time that passes without you. Different fill, different height,
